}
library(tidyverse)
# Install and load nycflights13 for flight data
if (!requireNamespace("nycflights13", quietly = TRUE)) {
install.packages("nycflights13")
}
library(nycflights13)
# Install UtilsDataRSV
if (!requireNamespace("remotes", quietly = TRUE)) {
install.packages("remotes")
}
remotes::install_github("SATVILab/UtilsDataRSV")
glimpse(flights)
flights %>%
filter(month == 1) %>%
group_by(carrier) %>%
summarise(dist_mean = mean(distance), dist_sd = sd(distance)) %>%
arrange(dist_mean)
flights %>%
filter(month == 1) %>%
filter(carrier %in% c("OO", "YV", "F9", "AS")) %>%
group_by(carrier, distance) %>%
summarise(observations = n(), .groups = "drop")
flights %>%
group_by(month, carrier) %>%
summarise(avg_dep_delay = mean(dep_delay, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = carrier, values_from = avg_dep_delay)
flights %>%
filter(!is.na(dep_delay), !is.na(arr_delay)) %>%
summarise(proportion = sum(dep_delay > 0 & arr_delay <= 0) / n())
routes <- flights %>%
group_by(origin, dest) %>%
summarise(num_carriers = n_distinct(carrier), .groups = "drop") %>%
filter(num_carriers > 1) %>%
select(origin, dest)
routes
avg_delays <- routes %>%
inner_join(flights) %>%
group_by(origin, dest, carrier) %>%
summarise(avg_arr_delay = mean(arr_delay, na.rm = TRUE), .groups = "drop") %>%
left_join(airlines, by = "carrier") %>%
relocate(name, .before = avg_arr_delay)
avg_delays
avg_delays <- routes %>%
inner_join(flights, by = c("origin", "dest")) %>%
group_by(origin, dest, carrier) %>%
summarise(avg_arr_delay = mean(arr_delay, na.rm = TRUE), .groups = "drop") %>%
left_join(airlines, by = "carrier") %>%
relocate(name, .before = avg_arr_delay)
avg_delays
