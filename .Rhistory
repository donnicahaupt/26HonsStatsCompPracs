#| label: fig-dens-plot
#| fig-cap: "theoretical vs empirical density of a normal distribution"
set.seed(123)
x <- rnorm(100, mean = 3, sd = 1)
df_norm <- data.frame(x = x)
y <- dnorm(x, mean = 3, sd = 1)
ggplot(df_norm,aes(x = x)) +
geom_density(fill = "blue", color = "blue", alpha = 0.3, linewidth = 0.5) +
geom_line(aes(y = y), linetype = 2, linewidth = 1, color = "red") +
labs(title = "Normal Distribution",
subtitle = "Mean = 3 and Standard deviation = 1",
x = "empirical density",
y = "theoretical density") +
theme_cowplot() + background_grid() + scale_color_colorblind()
